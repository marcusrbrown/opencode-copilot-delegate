+const ANSI_ESCAPE_PATTERN = new RegExp(
+  '(?:\\u001B|\\u009B)[[\\]()#;?]*(?:(?:\\d{1,4}(?:;\\d{0,4})*)?[\\dA-PR-TZcf-nq-uy=><~]|(?:[\\dA-PR-TZcf-nq-uy=><~]))',
